#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage: mentat_heatmap <datasource> <x_col> <y_col> <z_col> [flags]

Render a heatmap.

Flags:
  -o, --output PATH   PNG output (default: ./mentat_heatmap.png)
  --ascii             Print ASCII preview to stdout
  --table NAME        Table name (required for SQLite)
  --title, --xlabel, --ylabel
  --help
EOF
}

[ "$#" -eq 0 ] || [ "$1" = "--help" ] && { usage; exit 0; }

DATASOURCE=""; X=""; Y=""; Z=""; O="./mentat_heatmap.png"; A=false
TITLE="Heatmap"; XL="X"; YL="Y"; TBL=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        -o|--output) O="$2"; shift 2 ;;
        --ascii) A=true; shift ;;
        --title) TITLE="$2"; shift 2 ;;
        --xlabel) XL="$2"; shift 2 ;;
        --ylabel) YL="$2"; shift 2 ;;
        --table) TBL="$2"; shift 2 ;;
        *) [ -z "$DATASOURCE" ] && DATASOURCE="$1" && shift && continue
           [ -z "$X" ] && X="$1" && shift && continue
           [ -z "$Y" ] && Y="$1" && shift && continue
           [ -z "$Z" ] && Z="$1" && shift || break ;;
    esac
done
[ -z "$DATASOURCE" ] && echo "ERROR: datasource required" >&2 && exit 1
[ -z "$X" ] && echo "ERROR: x_col required" >&2 && exit 1
[ -z "$Y" ] && echo "ERROR: y_col required" >&2 && exit 1
[ -z "$Z" ] && echo "ERROR: z_col required" >&2 && exit 1

ext="${DATASOURCE##*.}"
is_sqlite=false; [ "$ext" = "sqlite" ] || [ "$ext" = "db" ] && is_sqlite=true

sql_flat() { echo "SELECT CAST(\"${X}\" AS DOUBLE)AS x,CAST(\"${Y}\" AS DOUBLE)AS y,CAST(\"${Z}\" AS DOUBLE)AS z FROM $1 WHERE \"${X}\" IS NOT NULL AND \"${Y}\" IS NOT NULL AND \"${Z}\" IS NOT NULL LIMIT 50000"; }

sql_sqlite() { [ -z "$TBL" ] && echo "ERROR: --table required" >&2 && exit 1; echo "ATTACH '${DATASOURCE}' AS _d(TYPE SQLITE,READ_ONLY);$(sql_flat "_d.\"${TBL}\"" | tail -1)"; }

data=$(mktemp)
if $is_sqlite; then
    duckdb -csv -c "$(sql_sqlite)" > "$data" 2>&1 || { echo "ERROR: duckdb failed" >&2; cat "$data" >&2; rm "$data"; exit 1; }
else
    case "$ext" in
        csv) r="read_csv_auto('${DATASOURCE}')" ;;
        parquet) r="'${DATASOURCE}'" ;;
        json) r="read_json_auto('${DATASOURCE}')" ;;
        *) echo "ERROR: .${ext} unsupported" >&2; rm "$data"; exit 1 ;;
    esac
    duckdb -csv -c "$(sql_flat "$r")" > "$data" 2>&1 || { echo "ERROR: duckdb failed" >&2; cat "$data" >&2; rm "$data"; exit 1; }
fi

rows=$(wc -l < "$data"); [ "$rows" -le 1 ] && echo "ERROR: no data" >&2 && rm "$data" && exit 1

gp=$(mktemp)
cat > "$gp" <<G
set terminal pngcairo enhanced font 'sans,10' size 800,600
set output '${O}'; set datafile separator comma; set key off
set title "${TITLE}"; set xlabel "${XL}"; set ylabel "${YL}"
set view map; set dgrid3d 50,50 gauss; set pm3d interpolate 20,20
set palette defined (0 '#313695',1 '#4575B4',2 '#74ADD1',3 '#ABD9E9',4 '#E0F3F8',5 '#FFFFBF',6 '#FEE090',7 '#FDAE61',8 '#F46D43',9 '#D73027',10 '#A50026')
splot '${data}' using 1:2:3 every ::1 with pm3d notitle
G
gnuplot "$gp" 2>/dev/null || { echo "ERROR: gnuplot failed" >&2; rm "$gp" "$data"; exit 1; }
echo "saved: ${O}"

$A && { cat > "$gp" <<G; set terminal dumb 80 25; set datafile separator comma; set key off
set view map; set dgrid3d 30,30 gauss; set pm3d interpolate 10,10
splot '${data}' using 1:2:3 every ::1 with pm3d notitle
G
gnuplot "$gp" 2>/dev/null || true; }

rm "$gp" "$data"
