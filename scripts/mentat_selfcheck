#!/usr/bin/env bash
set -euo pipefail

errors=0
warnings=0

check_cmd() {
    local name="$1"
    local min_version="${2:-}"
    if ! command -v "$name" &>/dev/null; then
        echo "MISSING: $name"
        errors=1
        return
    fi
    if [ -n "$min_version" ]; then
        local version
        version=$("$name" --version 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -1 || echo "unknown")
        echo "FOUND: $name (v$version, path: $(command -v "$name"))"
    else
        echo "FOUND: $name ($(command -v "$name"))"
    fi
}

echo "=== Mentat dependency check ==="
echo ""

check_cmd duckdb "0.9"
check_cmd qsv
check_cmd gnuplot

echo ""

if [ $errors -eq 0 ]; then
    echo "All dependencies found."
    exit 0
fi

echo "ERROR: Missing dependencies. See README for install instructions."
echo ""
echo "Quick install:"
echo "  macOS:   brew install duckdb qsv gnuplot"
echo "  Ubuntu:  sudo apt install duckdb gnuplot"
echo "           (QSV: https://github.com/jqnatividad/qsv/releases)"
echo "  NixOS:   add duckdb, qsv, gnuplot to your packages"
exit 1
