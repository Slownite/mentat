#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage: mentat_query <path> <sql> [flags]

Execute a SQL query against a data source and return stats-enriched results.

Arguments:
  <path>    Data source path (.sqlite, .db, .csv, .parquet, .json) or directory
  <sql>     SQL query to execute

Flags:
  --histogram --bins=N     Return binned (center, count) pairs for the first numeric column
  --groupby <col>          Return per-group stats instead of global stats
  --timeseries             Time-bucketed output for the first datetime + numeric column pair
    --bucket=auto|hourly|daily|weekly|monthly|yearly   Bucket granularity (default: auto)
  --outlier-method=iqr|zscore   Outlier detection method (default: iqr)
  --raw                    Bypass stats, return raw rows as TSV (capped at 1000 rows)
  --help                   Show this help

Output format (default, for numeric columns):
  rows=N | min=X max=X mean=X median=X p25=X p75=X | outliers=N bounds=[X,Y] (method)
  sample: [val1, val2, ...]

EOF
}

if [ $# -eq 0 ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

# Parse arguments
DB_PATH=""
SQL=""
MODE="default"
BINS=50
GROUPBY_COL=""
TIMESERIES_BUCKET="auto"
OUTLIER_METHOD="iqr"
RAW=false
HISTOGRAM=false
TIMESERIES=false

while [ $# -gt 0 ]; do
    case "$1" in
        --histogram)
            HISTOGRAM=true
            MODE="histogram"
            if [ "${2:-}" != "" ] && [[ "$2" != --* ]]; then
                BINS="$2"
                shift
            fi
            shift
            ;;
        --bins)
            BINS="$2"
            shift 2
            ;;
        --groupby)
            MODE="groupby"
            GROUPBY_COL="$2"
            shift 2
            ;;
        --timeseries)
            TIMESERIES=true
            MODE="timeseries"
            shift
            ;;
        --bucket)
            TIMESERIES_BUCKET="$2"
            shift 2
            ;;
        --outlier-method)
            OUTLIER_METHOD="$2"
            shift 2
            ;;
        --raw)
            RAW=true
            MODE="raw"
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            if [ -z "$DB_PATH" ]; then
                DB_PATH="$1"
            elif [ -z "$SQL" ]; then
                SQL="$1"
            fi
            shift
            ;;
    esac
done

if [ -z "$DB_PATH" ]; then
    echo "ERROR: No data source path provided."
    usage
    exit 1
fi

if [ -z "$SQL" ]; then
    echo "ERROR: No SQL query provided."
    usage
    exit 1
fi

# Detect data source type
ext="${DB_PATH##*.}"
is_sqlite=false
if [ -f "$DB_PATH" ] && ([ "$ext" = "sqlite" ] || [ "$ext" = "db" ]); then
    is_sqlite=true
fi

# Build the DuckDB command
build_duckdb_sql() {
    local user_sql="$1"
    if $is_sqlite; then
        echo "ATTACH '${DB_PATH}' AS _db (TYPE SQLITE, READ_ONLY); ${user_sql}"
    else
        echo "$user_sql"
    fi
}

# Execute DuckDB query and get results
run_query() {
    local dsql="$1"
    local format="${2:-csv}"
    if $is_sqlite; then
        duckdb -"${format}" -c "$dsql" 2>&1
    else
        # For non-SQLite, the user SQL references files directly
        duckdb -"${format}" -c "$dsql" 2>&1
    fi
}

TIMEOUT_SEC=30

# Raw mode: just return rows
if $RAW; then
    dsql=$(build_duckdb_sql "$SQL")
    output=$(timeout "$TIMEOUT_SEC" run_query "$dsql" "csv" 2>&1) || {
        exit_code=$?
        if [ $exit_code -eq 124 ]; then
            echo "ERROR: Query timed out after ${TIMEOUT_SEC}s. Consider adding WHERE clauses or LIMIT."
            exit 2
        fi
        echo "ERROR: $output"
        exit 1
    }
    echo "$output" | head -1001
    row_count=$(echo "$output" | tail -n +2 | head -1000 | wc -l)
    echo "# raw rows: ${row_count} (capped at 1000)"
    exit 0
fi

# Get query results as CSV
dsql=$(build_duckdb_sql "$SQL")
result=$(timeout "$TIMEOUT_SEC" run_query "$dsql" "csv" 2>&1) || {
    exit_code=$?
    if [ $exit_code -eq 124 ]; then
        echo "ERROR: Query timed out after ${TIMEOUT_SEC}s. Consider adding WHERE clauses or LIMIT."
        exit 2
    fi
    echo "ERROR: $result"
    exit 1
}

# Get result count and column names
row_count=$(echo "$result" | tail -n +2 | wc -l)
header=$(echo "$result" | head -1)
col_names=()
IFS=',' read -ra col_names <<< "$header"

if [ "$row_count" -eq 0 ]; then
    echo "rows=0"
    echo "No matching data found. Check your filters or schema."
    exit 0
fi

if [ "$row_count" -eq 1 ]; then
    echo "rows=1"
    echo "WARNING: Only 1 row returned. Insufficient data for statistical analysis (need >= 10 rows)."
    echo "sample: $(echo "$result" | tail -1)"
    exit 0
fi

# Write results to temp file for aggregation queries
tmp_data=$(mktemp)
echo "$result" > "$tmp_data"

# Histogram mode
if $HISTOGRAM; then
    first_col="${col_names[0]}"
    # Check if the column is numeric
    is_numeric=$(duckdb -csv -noheader -c "
        SELECT CASE WHEN COUNT(*) > 0 THEN 'true' ELSE 'false' END
        FROM read_csv_auto('${tmp_data}')
        WHERE TRY_CAST(\"${first_col}\" AS DOUBLE) IS NOT NULL;
    " 2>/dev/null || echo "false")

    if [ "$is_numeric" = "true" ]; then
        duckdb -csv -c "
            WITH data AS (
                SELECT CAST(\"${first_col}\" AS DOUBLE) AS val
                FROM read_csv_auto('${tmp_data}')
                WHERE val IS NOT NULL
            ),
            bounds AS (
                SELECT MIN(val) AS min_val, MAX(val) AS max_val FROM data
            ),
            hist AS (
                SELECT
                    CASE
                        WHEN max_val = min_val THEN val
                        ELSE FLOOR((val - min_val) / ((max_val - min_val) / ${BINS})) * ((max_val - min_val) / ${BINS}) + ((max_val - min_val) / ${BINS}) / 2 + min_val
                    END AS bin_center,
                    COUNT(*) AS cnt
                FROM data, bounds
                GROUP BY bin_center
                ORDER BY bin_center
            )
            SELECT ROUND(bin_center, 2) AS bin_center, cnt FROM hist ORDER BY bin_center;
        " 2>/dev/null
    else
        # Categorical: treat as frequency
        duckdb -csv -c "
            SELECT \"${first_col}\" AS category, COUNT(*) AS frequency
            FROM read_csv_auto('${tmp_data}')
            GROUP BY category
            ORDER BY frequency DESC
            LIMIT 50;
        " 2>/dev/null
    fi
    rm "$tmp_data"
    exit 0
fi

# Timeseries mode
if $TIMESERIES; then
    first_col="${col_names[0]}"
    second_col="${col_names[1]}"

    # Auto-detect bucket if needed
    if [ "$TIMESERIES_BUCKET" = "auto" ]; then
        # Find the time span
        span=$(duckdb -csv -noheader -c "
            WITH data AS (
                SELECT TRY_CAST(\"${first_col}\" AS TIMESTAMP) AS ts
                FROM read_csv_auto('${tmp_data}')
                WHERE ts IS NOT NULL
            )
            SELECT MAX(ts) - MIN(ts) FROM data;
        " 2>/dev/null || echo "")

        # Determine granularity from span
        # We get interval as seconds from DuckDB, so we approximate
        TIMESERIES_BUCKET="daily"  # default
        if [ -n "$span" ]; then
            bucket=$(duckdb -csv -noheader -c "
                WITH data AS (
                    SELECT TRY_CAST(\"${first_col}\" AS TIMESTAMP) AS ts
                    FROM read_csv_auto('${tmp_data}')
                    WHERE ts IS NOT NULL
                )
                SELECT
                    CASE
                        WHEN DATE_DIFF('day', MIN(ts), MAX(ts)) <= 7 THEN 'hourly'
                        WHEN DATE_DIFF('day', MIN(ts), MAX(ts)) <= 90 THEN 'daily'
                        WHEN DATE_DIFF('day', MIN(ts), MAX(ts)) <= 730 THEN 'weekly'
                        WHEN DATE_DIFF('day', MIN(ts), MAX(ts)) <= 3650 THEN 'monthly'
                        ELSE 'yearly'
                    END
                FROM data;
            " 2>/dev/null || echo "daily")
            TIMESERIES_BUCKET="$bucket"
        fi
    fi

    echo "# timeseries bucket: ${TIMESERIES_BUCKET}"

    # Build time bucket expression
    case "$TIMESERIES_BUCKET" in
        hourly) bucket_expr="DATE_TRUNC('hour', CAST(\"${first_col}\" AS TIMESTAMP))" ;;
        daily)  bucket_expr="DATE_TRUNC('day', CAST(\"${first_col}\" AS TIMESTAMP))" ;;
        weekly) bucket_expr="DATE_TRUNC('week', CAST(\"${first_col}\" AS TIMESTAMP))" ;;
        monthly) bucket_expr="DATE_TRUNC('month', CAST(\"${first_col}\" AS TIMESTAMP))" ;;
        yearly) bucket_expr="DATE_TRUNC('year', CAST(\"${first_col}\" AS TIMESTAMP))" ;;
        *) bucket_expr="DATE_TRUNC('day', CAST(\"${first_col}\" AS TIMESTAMP))" ;;
    esac

    duckdb -csv -c "
        WITH data AS (
            SELECT
                ${bucket_expr} AS ts_bucket,
                TRY_CAST(\"${second_col}\" AS DOUBLE) AS val
            FROM read_csv_auto('${tmp_data}')
            WHERE ts_bucket IS NOT NULL
        ),
        aggregated AS (
            SELECT
                ts_bucket,
                COUNT(*) AS n,
                AVG(val) AS mean,
                MEDIAN(val) AS median,
                MIN(val) AS min_val,
                MAX(val) AS max_val
            FROM data
            WHERE val IS NOT NULL
            GROUP BY ts_bucket
            ORDER BY ts_bucket
        )
        -- Fill gaps with zeros
        SELECT
            ts_bucket,
            COALESCE(n, 0) AS n,
            COALESCE(ROUND(mean, 2), 0) AS mean,
            COALESCE(median, 0) AS median,
            COALESCE(min_val, 0) AS min_val,
            COALESCE(max_val, 0) AS max_val
        FROM aggregated;
    " 2>/dev/null
    echo "# gaps filled with zeros"
    rm "$tmp_data"
    exit 0
fi

# Groupby mode
if [ "$MODE" = "groupby" ] && [ -n "$GROUPBY_COL" ]; then
    second_col="${col_names[1]}"
    duckdb -csv -c "
        SELECT
            \"${GROUPBY_COL}\" AS group_key,
            COUNT(*) AS n,
            AVG(TRY_CAST(\"${second_col}\" AS DOUBLE)) AS mean,
            MEDIAN(TRY_CAST(\"${second_col}\" AS DOUBLE)) AS median,
            MIN(TRY_CAST(\"${second_col}\" AS DOUBLE)) AS min_val,
            MAX(TRY_CAST(\"${second_col}\" AS DOUBLE)) AS max_val
        FROM read_csv_auto('${tmp_data}')
        GROUP BY group_key
        ORDER BY n DESC;
    " 2>/dev/null
    rm "$tmp_data"
    exit 0
fi

# Default mode: compute stats on the first numeric column
first_col="${col_names[0]}"

# Check if the first column is numeric
is_numeric=$(duckdb -csv -noheader -c "
    SELECT CASE WHEN COUNT(*) > 0 THEN 'true' ELSE 'false' END
    FROM read_csv_auto('${tmp_data}')
    WHERE TRY_CAST(\"${first_col}\" AS DOUBLE) IS NOT NULL;
" 2>/dev/null || echo "false")

# Stats output
output="rows=${row_count}"

if [ "$is_numeric" = "true" ]; then
    # Compute stats via DuckDB
    stats=$(duckdb -csv -noheader -c "
        WITH nums AS (
            SELECT TRY_CAST(\"${first_col}\" AS DOUBLE) AS val
            FROM read_csv_auto('${tmp_data}')
            WHERE val IS NOT NULL
        )
        SELECT
            ROUND(MIN(val), 2) AS min_val,
            ROUND(MAX(val), 2) AS max_val,
            ROUND(AVG(val), 2) AS mean,
            ROUND(MEDIAN(val), 2) AS median,
            ROUND(QUANTILE_CONT(val, 0.25), 2) AS p25,
            ROUND(QUANTILE_CONT(val, 0.75), 2) AS p75,
            ROUND(STDDEV_SAMP(val), 2) AS stddev
        FROM nums;
    " 2>/dev/null)

    if [ -n "$stats" ]; then
        min_val=$(echo "$stats" | cut -d',' -f1)
        max_val=$(echo "$stats" | cut -d',' -f2)
        mean_val=$(echo "$stats" | cut -d',' -f3)
        median_val=$(echo "$stats" | cut -d',' -f4)
        p25=$(echo "$stats" | cut -d',' -f5)
        p75=$(echo "$stats" | cut -d',' -f6)
        stddev_val=$(echo "$stats" | cut -d',' -f7)

        output="${output} | min=${min_val} max=${max_val} mean=${mean_val} median=${median_val} p25=${p25} p75=${p75}"

        # Outlier detection
        if [ "$p25" != "" ] && [ "$p75" != "" ] && [ "$p25" != "$p75" ]; then
            if [ "$OUTLIER_METHOD" = "zscore" ] && [ "$stddev_val" != "" ] && [ "$stddev_val" != "0.00" ]; then
                lower_bound=$(echo "scale=2; $mean_val - 3 * $stddev_val" | bc 2>/dev/null || echo "?")
                upper_bound=$(echo "scale=2; $mean_val + 3 * $stddev_val" | bc 2>/dev/null || echo "?")
                outlier_cnt=$(duckdb -csv -noheader -c "
                    SELECT COUNT(*)
                    FROM read_csv_auto('${tmp_data}')
                    WHERE TRY_CAST(\"${first_col}\" AS DOUBLE) < ${lower_bound}
                       OR TRY_CAST(\"${first_col}\" AS DOUBLE) > ${upper_bound};
                " 2>/dev/null || echo "?")
                output="${output} | outliers=${outlier_cnt} bounds=[${lower_bound},${upper_bound}] (zscore)"
            else
                # IQR method (default)
                iqr=$(echo "scale=2; $p75 - $p25" | bc 2>/dev/null || echo "0")
                lower_bound=$(echo "scale=2; $p25 - 1.5 * $iqr" | bc 2>/dev/null || echo "?")
                upper_bound=$(echo "scale=2; $p75 + 1.5 * $iqr" | bc 2>/dev/null || echo "?")
                outlier_cnt=$(duckdb -csv -noheader -c "
                    SELECT COUNT(*)
                    FROM read_csv_auto('${tmp_data}')
                    WHERE TRY_CAST(\"${first_col}\" AS DOUBLE) < ${lower_bound}
                       OR TRY_CAST(\"${first_col}\" AS DOUBLE) > ${upper_bound};
                " 2>/dev/null || echo "?")
                output="${output} | outliers=${outlier_cnt} bounds=[${lower_bound},${upper_bound}] (iqr)"
            fi
        fi
    fi
else
    # Categorical column: show value frequencies
    output="${output} | categorical"
    freq=$(duckdb -csv -c "
        SELECT \"${first_col}\" AS value, COUNT(*) AS count
        FROM read_csv_auto('${tmp_data}')
        GROUP BY value
        ORDER BY count DESC
        LIMIT 10;
    " 2>/dev/null || echo "")
    if [ -n "$freq" ]; then
        output="${output}\n${freq}"
    fi
fi

# Sample values (first 10)
sample=$(duckdb -csv -c "
    SELECT *
    FROM read_csv_auto('${tmp_data}')
    LIMIT 10;
" 2>/dev/null || echo "")

sample_vals=""
if [ -n "$sample" ]; then
    sample_vals=$(echo "$sample" | tail -n +2 | head -10 | cut -d',' -f1 | paste -sd ',' -)
fi

echo -e "$output"
echo "sample: [${sample_vals}]"

rm "$tmp_data"
