#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<EOF
Usage: mentat_plot <data_file> <template> <output_path> [flags]

Render a visualization from a data file using Gnuplot templates.

Arguments:
  <data_file>    TSV/CSV data file (output from mentat_query)
  <template>     Chart template: histogram, scatter, line, bar, boxplot, heatmap, facet
  <output_path>  Output file path (.png for image, or dash for stdout with --ascii)

Flags:
  --title TEXT       Chart title
  --xlabel TEXT      X-axis label
  --ylabel TEXT      Y-axis label
  --facet COL        Facet by this column (uses facet template with multiplot)
  --ascii            Render ASCII dumb-terminal output instead of PNG
  --help             Show this help

Templates:
  histogram    Binned data: bin_center, count
  scatter      Point data: x, y
  line         Time/data series: x, y (sorted by x)
  bar          Categorical: category, value
  boxplot      Grouped data: category, value (multiple values per category)
  heatmap      Matrix data: x, y, value
  facet        Multi-panel: col, x, y (one panel per unique col value)

EOF
}

if [ $# -eq 0 ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

# Parse arguments
DATA_FILE=""
TEMPLATE=""
OUTPUT_PATH=""
TITLE=""
XLABEL=""
YLABEL=""
FACET_COL=""
ASCI_MODE=false

while [ $# -gt 0 ]; do
    case "$1" in
        --title)
            TITLE="$2"
            shift 2
            ;;
        --xlabel)
            XLABEL="$2"
            shift 2
            ;;
        --ylabel)
            YLABEL="$2"
            shift 2
            ;;
        --facet)
            FACET_COL="$2"
            TEMPLATE="facet"
            shift 2
            ;;
        --ascii)
            ASCI_MODE=true
            shift
            ;;
        --help)
            usage
            exit 0
            ;;
        *)
            if [ -z "$DATA_FILE" ]; then
                DATA_FILE="$1"
            elif [ -z "$TEMPLATE" ]; then
                TEMPLATE="$1"
            elif [ -z "$OUTPUT_PATH" ]; then
                OUTPUT_PATH="$1"
            fi
            shift
            ;;
    esac
done

if [ -z "$DATA_FILE" ]; then
    echo "ERROR: No data file provided."
    usage
    exit 1
fi

if [ ! -f "$DATA_FILE" ]; then
    echo "ERROR: Data file not found: $DATA_FILE"
    exit 1
fi

if [ -z "$TEMPLATE" ]; then
    echo "ERROR: No template specified."
    usage
    exit 1
fi

if [ -z "$OUTPUT_PATH" ] && ! $ASCI_MODE; then
    echo "ERROR: No output path specified."
    usage
    exit 1
fi

if ! command -v gnuplot &>/dev/null; then
    echo "ERROR: Gnuplot is not installed."
    exit 1
fi

# Generate Gnuplot script
GNUPLOT_SCRIPT=$(mktemp)

write_histogram_script() {
    cat > "$GNUPLOT_SCRIPT" <<GNUPLOT
set style data histogram
set style histogram cluster gap 1
set style fill solid border -1
set boxwidth 0.9
set key off
set title "${TITLE:-Histogram}"
set xlabel "${XLABEL:-Value}"
set ylabel "${YLABEL:-Count}"
plot '${DATA_FILE}' using 2:xtic(1) with boxes lc rgb '#4A90D9'
GNUPLOT
}

write_scatter_script() {
    cat > "$GNUPLOT_SCRIPT" <<GNUPLOT
set title "${TITLE:-Scatter Plot}"
set xlabel "${XLABEL:-X}"
set ylabel "${YLABEL:-Y}"
set key off
plot '${DATA_FILE}' using 1:2 with points pt 7 ps 0.5 lc rgb '#D94A4A'
GNUPLOT
}

write_line_script() {
    cat > "$GNUPLOT_SCRIPT" <<GNUPLOT
set title "${TITLE:-Line Chart}"
set xlabel "${XLABEL:-Time}"
set ylabel "${YLABEL:-Value}"
set key off
set xdata time
set timefmt "%Y-%m-%d %H:%M:%S"
set format x "%Y-%m-%d"
set grid
plot '${DATA_FILE}' using 1:2 with lines lw 2 lc rgb '#4A90D9'
GNUPLOT
}

write_bar_script() {
    cat > "$GNUPLOT_SCRIPT" <<GNUPLOT
set style data histogram
set style histogram cluster gap 1
set style fill solid border -1
set boxwidth 0.8
set title "${TITLE:-Bar Chart}"
set xlabel "${XLABEL:-Category}"
set ylabel "${YLABEL:-Value}"
set key off
set xtics rotate by -45
plot '${DATA_FILE}' using 2:xtic(1) with boxes lc rgb '#50B86C'
GNUPLOT
}

write_boxplot_script() {
    cat > "$GNUPLOT_SCRIPT" <<GNUPLOT
set title "${TITLE:-Boxplot}"
set xlabel "${XLABEL:-Category}"
set ylabel "${YLABEL:-Value}"
set key off
set style data boxplot
set style boxplot outliers pointtype 7
set xtics rotate by -45
plot '${DATA_FILE}' using (1.0):1 with boxplot lc rgb '#4A90D9'
GNUPLOT
}

write_heatmap_script() {
    cat > "$GNUPLOT_SCRIPT" <<GNUPLOT
set title "${TITLE:-Heatmap}"
set xlabel "${XLABEL:-X}"
set ylabel "${YLABEL:-Y}"
set view map
set dgrid3d 50,50 gauss
set pm3d interpolate 20,20
set palette defined (0 '#313695', 1 '#4575B4', 2 '#74ADD1', 3 '#ABD9E9', 4 '#E0F3F8', 5 '#FFFFBF', 6 '#FEE090', 7 '#FDAE61', 8 '#F46D43', 9 '#D73027', 10 '#A50026')
splot '${DATA_FILE}' using 1:2:3 with pm3d notitle
GNUPLOT
}

write_facet_script() {
    # For facet, we need to split data by the facet column
    # This is complex; for v1 we do a simple approach: split data into temp files per group
    if [ -z "$FACET_COL" ]; then
        echo "ERROR: --facet requires a column name for faceting."
        exit 1
    fi

    # Split data by the first column (facet column)
    tmpdir=$(mktemp -d)
    groups=$(cut -d',' -f1 "$DATA_FILE" | tail -n +2 | sort -u)
    group_count=$(echo "$groups" | wc -l)

    # Calculate grid layout
    cols=2
    if [ "$group_count" -le 2 ]; then
        cols="$group_count"
    elif [ "$group_count" -le 6 ]; then
        cols=3
    else
        cols=4
    fi
    rows=$(( (group_count + cols - 1) / cols ))

    cat > "$GNUPLOT_SCRIPT" <<GNUPLOT
set multiplot layout ${rows},${cols} title "${TITLE:-Faceted Chart}"
set style data histogram
set style histogram cluster gap 1
set style fill solid border -1
set boxwidth 0.8
set key off
GNUPLOT

    i=1
    echo "$groups" | while IFS= read -r group; do
        group_safe=$(echo "$group" | xargs | sed 's/[^a-zA-Z0-9]/_/g')
        group_file="${tmpdir}/facet_${group_safe}.csv"
        head -1 "$DATA_FILE" > "$group_file"
        grep "^${group}," "$DATA_FILE" >> "$group_file" 2>/dev/null || true

        if [ -s "$group_file" ] && [ "$(wc -l < "$group_file")" -gt 1 ]; then
            cat >> "$GNUPLOT_SCRIPT" <<GNUPLOT
set title "${group}"
set xlabel "${XLABEL:-Category}"
set ylabel "${YLABEL:-Value}"
plot '${group_file}' using 2:xtic(1) with boxes lc rgb '#4A90D9'
GNUPLOT
        else
            cat >> "$GNUPLOT_SCRIPT" <<GNUPLOT
set title "${group} (no data)"
plot 1/0 with boxes
GNUPLOT
        fi
        i=$((i + 1))
    done

    echo "unset multiplot" >> "$GNUPLOT_SCRIPT"

    # Cleanup
    rm -rf "$tmpdir"
}

# Write the selected template
case "$TEMPLATE" in
    histogram) write_histogram_script ;;
    scatter)   write_scatter_script ;;
    line)      write_line_script ;;
    bar)       write_bar_script ;;
    boxplot)   write_boxplot_script ;;
    heatmap)   write_heatmap_script ;;
    facet)     write_facet_script ;;
    *)
        echo "ERROR: Unknown template '${TEMPLATE}'. Use: histogram, scatter, line, bar, boxplot, heatmap, facet"
        rm "$GNUPLOT_SCRIPT"
        exit 1
        ;;
esac

if $ASCI_MODE; then
    # ASCII dumb-terminal output
    cat > /tmp/mentat_ascii_plot.gp <<GNUPLOT
set terminal dumb 80 25
set key off
GNUPLOT
    cat "$GNUPLOT_SCRIPT" | grep -v 'set terminal' | grep -v 'set output' >> /tmp/mentat_ascii_plot.gp
    gnuplot /tmp/mentat_ascii_plot.gp 2>&1
    rm /tmp/mentat_ascii_plot.gp
else
    # PNG output
    mkdir -p "$(dirname "$OUTPUT_PATH")"
    cat > /tmp/mentat_plot_final.gp <<GNUPLOT
set terminal pngcairo enhanced font 'sans,10' size 800,600
set output '${OUTPUT_PATH}'
GNUPLOT
    # Copy script content without any existing terminal/output directives
    grep -v 'set terminal' "$GNUPLOT_SCRIPT" | grep -v 'set output' >> /tmp/mentat_plot_final.gp

    # Run Gnuplot
    plot_output=$(gnuplot /tmp/mentat_plot_final.gp 2>&1) || {
        exit_code=$?
        echo "ERROR: Gnuplot failed."
        echo "--- script ---"
        cat /tmp/mentat_plot_final.gp
        echo "--- stderr ---"
        echo "$plot_output"
        echo "--- data sample (first 20 lines) ---"
        head -20 "$DATA_FILE"
        rm /tmp/mentat_plot_final.gp
        exit $exit_code
    }

    echo "Plot saved: ${OUTPUT_PATH}"

    # Also generate ASCII preview for verification
    cat > /tmp/mentat_ascii_preview.gp <<GNUPLOT
set terminal dumb 80 25
set key off
GNUPLOT
    grep -v 'set terminal' "$GNUPLOT_SCRIPT" | grep -v 'set output' >> /tmp/mentat_ascii_preview.gp
    gnuplot /tmp/mentat_ascii_preview.gp 2>&1

    rm /tmp/mentat_plot_final.gp /tmp/mentat_ascii_preview.gp
fi

rm "$GNUPLOT_SCRIPT"
