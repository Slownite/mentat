#!/usr/bin/env bash
set -euo pipefail

cleanup() { rm -f ".mentat_data_$$.csv" ".mentat_gp_$$.gp"; }
trap cleanup EXIT

usage() {
    cat <<EOF
Usage: mentat_line <datasource> <time_col> <value_col> [flags]

Render a time-series line chart.

Flags:
  -o, --output PATH        PNG output (default: ./mentat_line.png)
  --ascii                  Print ASCII preview to stdout
  --bucket auto|hourly|daily|weekly|monthly|yearly
  --facet COL              Multi-panel by this column
  --table NAME             Table name (required for SQLite)
  --title, --xlabel, --ylabel
  --help
EOF
}

[ "$#" -eq 0 ] || [ "$1" = "--help" ] && { usage; exit 0; }

DATASOURCE=""; TC=""; VC=""; O="./mentat_line.png"; A=false
BUCKET="auto"; FACET=""; TITLE="Line Chart"; XL="$TC"; YL="$VC"; TBL=""
XL_SET=false; YL_SET=false

while [ "$#" -gt 0 ]; do
    case "$1" in
        -o|--output) O="$2"; shift 2 ;;
        --ascii) A=true; shift ;;
        --bucket) BUCKET="$2"; shift 2 ;;
        --facet) FACET="$2"; shift 2 ;;
        --title) TITLE="$2"; shift 2 ;;
        --xlabel) XL="$2"; XL_SET=true; shift 2 ;;
        --ylabel) YL="$2"; YL_SET=true; shift 2 ;;
        --table) TBL="$2"; shift 2 ;;
        *) [ -z "$DATASOURCE" ] && DATASOURCE="$1" && shift && continue
           [ -z "$TC" ] && TC="$1" && shift && continue
           [ -z "$VC" ] && VC="$1" && shift || break ;;
    esac
done
[ -z "$DATASOURCE" ] && echo "ERROR: datasource required" >&2 && exit 1
[ -z "$TC" ] && echo "ERROR: time_col required" >&2 && exit 1
[ -z "$VC" ] && echo "ERROR: value_col required" >&2 && exit 1
$XL_SET || XL="$TC"
$YL_SET || YL="$VC"

ext="${DATASOURCE##*.}"
is_sqlite=false; [ "$ext" = "sqlite" ] || [ "$ext" = "db" ] && is_sqlite=true

bucket_expr() {
    local ts="\"${TC}\"" src="$1"
    echo "CASE WHEN DATE_DIFF('day',MIN($ts),MAX($ts))<=7 THEN 'hourly' WHEN DATE_DIFF('day',MIN($ts),MAX($ts))<=90 THEN 'daily' WHEN DATE_DIFF('day',MIN($ts),MAX($ts))<=730 THEN 'weekly' WHEN DATE_DIFF('day',MIN($ts),MAX($ts))<=3650 THEN 'monthly' ELSE 'yearly' END FROM $src"
}
bf() {
    local b="$1" ts="\"${TC}\""
    case "$b" in hourly) echo "DATE_TRUNC('hour',$ts)" ;; daily) echo "DATE_TRUNC('day',$ts)" ;; weekly) echo "DATE_TRUNC('week',$ts)" ;; monthly) echo "DATE_TRUNC('month',$ts)" ;; yearly) echo "DATE_TRUNC('year',$ts)" ;; auto) echo "auto" ;; *) echo "DATE_TRUNC('day',$ts)" ;;
    esac
}

sql_flat() {
    local b
    [ "$BUCKET" = "auto" ] && b="$(bucket_expr "$1")" || b="${BUCKET}"
    local be
    case "$b" in
        hourly|daily|weekly|monthly|yearly) be=$(bf "$b") ;;
        auto*) be=$(bf "$(echo "$1" | duckdb -csv -c "SELECT $(bucket_expr "$1")" 2>/dev/null || echo "daily")") ;;
        *) be="DATE_TRUNC('day',\"${TC}\")" ;;
    esac
    echo "SELECT $be AS ts,ROUND(AVG(CAST(\"${VC}\" AS DOUBLE)),2) AS val FROM $1 WHERE \"${TC}\" IS NOT NULL AND \"${VC}\" IS NOT NULL GROUP BY ts ORDER BY ts"
}

sql_sqlite() { [ -z "$TBL" ] && echo "ERROR: --table required" >&2 && exit 1; echo "ATTACH '${DATASOURCE}' AS _d(TYPE SQLITE,READ_ONLY);$(echo "$(sql_flat "_d.\"${TBL}\"")" | sed 's/DATE_TRUNC/date_trunc/g')"; }

data=".mentat_data_$$.csv"
sql=""
if $is_sqlite; then
    sql=$(sql_sqlite)
    duckdb -csv -c "$sql" > "$data" 2>&1 || { echo "ERROR: duckdb failed" >&2; cat "$data" >&2; exit 1; }
else
    case "$ext" in
        csv) r="read_csv_auto('${DATASOURCE}')" ;;
        parquet) r="'${DATASOURCE}'" ;;
        json) r="read_json_auto('${DATASOURCE}')" ;;
        *) echo "ERROR: .${ext} unsupported" >&2; exit 1 ;;
    esac
    sql=$(sql_flat "$r")
    duckdb -csv -c "$sql" > "$data" 2>&1 || { echo "ERROR: duckdb failed" >&2; cat "$data" >&2; exit 1; }
fi

rows=$(wc -l < "$data"); [ "$rows" -le 1 ] && {
    echo "ERROR: plot returned $((rows-1)) data rows (need >=2)" >&2
    echo "SQL: $sql" >&2
    echo "Tip: Check CAST failures — string columns can't be plotted as numeric" >&2
    exit 1
}

gp=".mentat_gp_$$.gp"
cat > "$gp" <<G
set terminal pngcairo enhanced font 'sans,10' size 800,600
set output '${O}'; set datafile separator comma; set key off
set title "${TITLE}"; set xlabel "${XL}"; set ylabel "${YL}"
set xdata time; set timefmt "%Y-%m-%d %H:%M:%S"; set format x "%Y-%m-%d"; set grid
plot '${data}' using 1:2 every ::1 with lines lw 2 lc rgb '#4A90D9'
G
gnuplot "$gp" || { echo "ERROR: gnuplot failed" >&2; exit 1; }
echo "saved: ${O}"

$A && {
    ascii_gp=".mentat_ascii_$$.gp"
    cat > "$ascii_gp" <<G; set terminal dumb 80 25; set datafile separator comma; set key off
set xdata time; set timefmt "%Y-%m-%d %H:%M:%S"; set format x "%m-%d"
set xlabel "${XL}"; set ylabel "${YL}"
plot '${data}' using 1:2 every ::1 with lines lw 2
G
    gnuplot "$ascii_gp" || true; rm -f "$ascii_gp"
}
